# =====================================================================
# MediCare Hospital Management System - Environment Configuration
# Copy this file to .env and fill in your local system details:
#   copy .env.example .env
# =====================================================================

# Server Port
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------
# SQLite Database Configuration (Default Embedded Storage)
# ---------------------------------------------------------------------
# Used by the web application for zero-config execution
DB_PATH=./database/hospital.db

# ---------------------------------------------------------------------
# MySQL Database Configuration (Local MySQL Server / MySQL Workbench)
# ---------------------------------------------------------------------
# Host where your MySQL Server is running (usually localhost or 127.0.0.1)
DB_HOST=127.0.0.1

# MySQL Port (Default for MySQL 8.0 is 3306)
DB_PORT=3306

# MySQL Database Name (created by hospital_management_system.sql)
DB_NAME=hospital_management_db

# MySQL Username (Default administrator user is 'root')
DB_USER=root

# MySQL Password (The password you set when installing MySQL Server 8.0)
DB_PASSWORD=your_mysql_password_here

# ---------------------------------------------------------------------
# MySQL Windows Installation Paths (Reference on your laptop)
# ---------------------------------------------------------------------
# Server Binary Path: C:\Program Files\MySQL\MySQL Server 8.0\bin\mysql.exe
# Workbench Path:     C:\Program Files\MySQL\MySQL Workbench 8.0\MySQLWorkbench.exe
# Configuration:      C:\ProgramData\MySQL\MySQL Server 8.0\my.ini
